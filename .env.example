# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=classerize

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Encryption (AES-256-CBC) ──────────────────────────────────────────────────
# 32-byte key as hex (64 hex chars):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here
# Not used at runtime (IV is generated per-encryption), but kept for reference
ENCRYPTION_IV=unused_iv_placeholder

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Canvas LMS ────────────────────────────────────────────────────────────────
# Default Canvas instance (users can override per account)
CANVAS_BASE_URL=https://canvas.instructure.com

# ── Blackboard (Phase 4) ──────────────────────────────────────────────────────
BLACKBOARD_BASE_URL=https://your-institution.blackboard.com/learn/api/public/v1
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Platform-level Gemini key. Free-tier users share this key (gemini-2.5-flash-lite).
# Pro users will also use this key but with gemini-2.5-flash.
# Users can supply their own key via Settings → AI (BYOK) to bypass platform limits.
# Get a key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Email / Notifications (Phase 5) ──────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@classerize.app

# ── Redis / BullMQ (Phase 2+) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
